<section class="page-head pad-sm" id="adminHead" hidden>
  <div class="wrap">
    <span class="pill rv in">Interné · správa rezervácií</span>
    <h1 class="rv in" style="font-size:clamp(32px,4.4vw,58px)">Správa <em class="ac">rezervácií</em></h1>
    <p class="lead rv in" style="margin-top:20px">Rezervácie, platby a potvrdenia pre hostí. Zmeny sa okamžite prejavia na verejnej stránke Obsadenosť.</p>
  </div>
</section>

<div class="gate" id="gate">
  <div class="panel">
    <h3>Prístup do správy</h3>
    <p class="hint">Zadajte PIN. (Demo prototyp — PIN sa nastavuje v <code>assets/booking.js</code>.)</p>
    <div class="field"><input id="pin" type="password" inputmode="numeric" maxlength="8" placeholder="••••" autocomplete="off"></div>
    <button class="btn btn-primary" id="pinBtn">Vstúpiť</button>
  </div>
</div>

<section class="pad-sm" id="adminApp" hidden>
  <div class="wrap">
    <div class="panel" style="margin-bottom:20px;background:var(--gold-soft)">
      <h3 style="margin-bottom:8px">Ako to funguje</h3>
      <p class="hint" style="margin:0;color:var(--ink)">Zdrojom pravdy pre nasadený web je súbor <code>data/bookings.json</code> v repozitári.
      Zmeny, ktoré tu urobíš, sa hneď prejavia v tomto prehliadači. Keď ich chceš zverejniť pre všetkých,
      klikni na <b>Stiahnuť data/bookings.json</b>, nahraď ním súbor v repozitári a pushni — Vercel to nasadí sám.</p>
    </div>

    <div class="toolbar-row">
      <button class="btn btn-primary" id="publishBtn">Stiahnuť data/bookings.json</button>
      <button class="btn btn-ghost" id="exportBtn">Export JSON</button>
      <label class="btn btn-ghost" style="cursor:pointer">Import JSON<input type="file" id="importInput" accept="application/json" hidden></label>
      <button class="btn btn-ghost" id="seedBtn">Načítať zo súboru</button>
      <button class="btn btn-ghost" id="wipeBtn">Vymazať všetko</button>
      <a class="btn btn-gold" href="obsadenost.html" target="_blank" rel="noopener">Verejný kalendár ↗</a>
    </div>

    <div class="admin-grid">
      <div class="panel" id="formPanel">
        <h3 id="formTitle">Nová rezervácia</h3>
        <p class="hint">Deň príchodu a odchodu sa v kalendári zobrazí ako polovica — ten istý deň tak môže nadviazať ďalší hosť.</p>
        <form id="bkForm">
          <input type="hidden" id="bk-id">
          <div class="row2">
            <div class="field"><label for="bk-apt">Apartmán</label>
              <select id="bk-apt"><option value="app1">APP1 · Kuca (6+1)</option><option value="app2">APP2 · Puca (4+1)</option></select></div>
            <div class="field"><label for="bk-status">Stav</label>
              <select id="bk-status"><option value="busy">Obsadené (potvrdené)</option><option value="opt">Predbežná opcia</option></select></div>
          </div>
          <div class="row2">
            <div class="field"><label for="bk-from">Príchod</label><input id="bk-from" type="date" required></div>
            <div class="field"><label for="bk-to">Odchod</label><input id="bk-to" type="date" required></div>
          </div>
          <div class="row2">
            <div class="field"><label for="bk-name">Hosť / označenie</label><input id="bk-name" placeholder="Rodina Nováková" required></div>
            <div class="field"><label for="bk-guests">Počet osôb</label><input id="bk-guests" type="number" min="0" max="13" placeholder="4"></div>
          </div>
          <div class="row2">
            <div class="field"><label for="bk-email">E-mail hosťa</label><input id="bk-email" type="email" placeholder="hoste@example.com"></div>
            <div class="field"><label for="bk-phone">Telefón</label><input id="bk-phone" type="tel" placeholder="+421 900 000 000"></div>
          </div>
          <div class="row2">
            <div class="field">
              <label for="bk-price">Cena celkom (€)</label>
              <input id="bk-price" type="number" min="0" step="1" placeholder="0">
            </div>
            <div class="field"><label for="bk-paid">Zaplatené (€)</label><input id="bk-paid" type="number" min="0" step="1" placeholder="0"></div>
          </div>
          <p class="calc-hint" id="calcHint">Zadajte termín a apartmán — cenu za noci doplním.</p>
          <div class="field"><label for="bk-note">Poznámka</label><textarea id="bk-note" placeholder="Záloha, špeciálne želania, kontakt…"></textarea></div>
          <button class="btn btn-primary" type="submit" id="submitBtn">Uložiť rezerváciu</button>
          <button class="btn btn-ghost" type="button" id="cancelEdit" hidden>Zrušiť úpravu</button>
        </form>
      </div>

      <div>
        <div class="panel" style="margin-bottom:20px">
          <h3>Prehľad sezóny <span id="statYear" style="color:var(--muted);font-weight:400"></span></h3>
          <p class="hint">Apríl – október, obidva apartmány spolu.</p>
          <div class="spec">
            <div><b>Rezervácií</b><span id="stCount">0</span></div>
            <div><b>Obsadených nocí</b><span id="stNights">0</span></div>
            <div><b>Predbežných opcií</b><span id="stOpts">0</span></div>
            <div><b>Naplnenosť sezóny</b><span id="stFill">0 %</span></div>
          </div>
          <div class="money-row">
            <div><b>Dohodnuté</b><span id="stPrice">0 €</span></div>
            <div><b>Zaplatené</b><span id="stPaid">0 €</span></div>
            <div><b>Zostáva</b><span id="stDue">0 €</span></div>
          </div>
          <div class="money-bar"><span id="moneyBar"></span></div>
        </div>
        <div class="panel">
          <h3>Zoznam rezervácií</h3>
          <p class="hint">Zoradené podľa dátumu príchodu.</p>
          <div class="bk-list" id="bkList"></div>
        </div>
      </div>
    </div>

    <div style="margin-top:clamp(26px,3vw,44px)">
      <div class="cal-toolbar">
        <div class="legend">
          <b><i class="sw-free"></i>voľné</b><b><i class="sw-opt"></i>opcia</b><b><i class="sw-busy"></i>obsadené</b>
        </div>
        <div class="yearpick">
          <button id="prevY" aria-label="Predchádzajúci rok">‹</button>
          <span class="y" id="yv">2026</span>
          <button id="nextY" aria-label="Nasledujúci rok">›</button>
        </div>
      </div>
      <div class="apt-cals" id="cals"></div>
    </div>
  </div>
</section>

<!-- potvrdzovacia správa -->
<div class="modal" id="msgModal" hidden>
  <div class="modal-box">
    <button class="modal-x" id="msgClose" aria-label="Zavrieť">✕</button>
    <h3 id="msgTitle">Potvrdenie pre hosťa</h3>
    <p class="hint" id="msgFor"></p>
    <div class="tabs">
      <button class="tab on" data-tab="email">E-mail</button>
      <button class="tab" data-tab="sms">SMS</button>
    </div>
    <div class="tabpane" id="paneEmail">
      <div class="field"><label for="msgSubject">Predmet</label><input id="msgSubject"></div>
      <div class="field"><label for="msgBody">Text správy</label><textarea id="msgBody" rows="16"></textarea></div>
      <div class="modal-actions">
        <a class="btn btn-primary" id="mailtoBtn" href="#">Otvoriť v e-maile</a>
        <button class="btn btn-ghost" data-copy="msgBody">Kopírovať text</button>
      </div>
    </div>
    <div class="tabpane" id="paneSms" hidden>
      <div class="field"><label for="msgSms">SMS <span id="smsLen" style="text-transform:none;letter-spacing:0"></span></label><textarea id="msgSms" rows="6"></textarea></div>
      <div class="modal-actions">
        <a class="btn btn-primary" id="smsBtn" href="#">Otvoriť v správach</a>
        <button class="btn btn-ghost" data-copy="msgSms">Kopírovať text</button>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-gold" id="markSentBtn">Označiť ako odoslané</button>
      <p class="hint" style="margin:0">Automatické odosielanie z webu potrebuje backend (napr. Resend alebo SendGrid na e-mail, Twilio na SMS). Dovtedy sa správa otvorí v tvojom klientovi s predvyplneným textom.</p>
    </div>
  </div>
</div>

<script src="assets/booking.js"></script>
<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var year = new Date().getFullYear();
  var openPay = null;

  /* ---------- PIN ---------- */
  function unlock() {
    $('gate').hidden = true; $('adminApp').hidden = false; $('adminHead').hidden = false;
    KP.boot(renderAll);
  }
  $('pinBtn').onclick = function () {
    if ($('pin').value === KP.PIN) { sessionStorage.setItem('kp_admin', '1'); unlock(); }
    else { KP.toast('Nesprávny PIN'); $('pin').value = ''; }
  };
  $('pin').addEventListener('keydown', function (e) { if (e.key === 'Enter') $('pinBtn').click(); });
  if (sessionStorage.getItem('kp_admin') === '1') unlock();

  /* ---------- formulár ---------- */
  function resetForm() {
    $('bk-id').value = ''; $('bkForm').reset();
    $('formTitle').textContent = 'Nová rezervácia';
    $('submitBtn').textContent = 'Uložiť rezerváciu';
    $('cancelEdit').hidden = true;
    updateCalc();
  }
  $('cancelEdit').onclick = resetForm;

  function suggestedPrice() {
    var f = $('bk-from').value, t = $('bk-to').value;
    if (!f || !t || t <= f) return 0;
    return KP.nights(f, t) * KP.apt($('bk-apt').value).price;
  }
  function updateCalc() {
    var s = suggestedPrice();
    var h = $('calcHint');
    if (!s) { h.innerHTML = 'Zadajte termín a apartmán — cenu za noci doplním.'; return; }
    var f = $('bk-from').value, t = $('bk-to').value;
    h.innerHTML = KP.nights(f, t) + ' nocí × ' + KP.apt($('bk-apt').value).price + ' € = <b>' + KP.eur(s) + '</b> ' +
      '<button type="button" class="linkbtn" id="useCalc">použiť</button>' +
      ' · záloha ' + KP.KONTAKT.zalohaPct + ' % = <b>' + KP.eur(Math.round(s * KP.KONTAKT.zalohaPct / 100)) + '</b>' +
      ' <button type="button" class="linkbtn" id="useDep">zapísať ako zaplatené</button>';
    $('useCalc').onclick = function () { $('bk-price').value = s; };
    $('useDep').onclick = function () { if (!$('bk-price').value) $('bk-price').value = s; $('bk-paid').value = Math.round(s * KP.KONTAKT.zalohaPct / 100); };
  }
  ['bk-from', 'bk-to', 'bk-apt'].forEach(function (id) { $(id).addEventListener('change', updateCalc); });

  $('bkForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var from = $('bk-from').value, to = $('bk-to').value;
    if (!from || !to || to < from) { KP.toast('Skontrolujte dátumy'); return; }
    var list = KP.load(), id = $('bk-id').value;
    var prev = list.filter(function (b) { return b.id === id; })[0] || {};
    var rec = {
      id: id || KP.uid(), apt: $('bk-apt').value, from: from, to: to,
      name: $('bk-name').value.trim(), status: $('bk-status').value,
      guests: +$('bk-guests').value || 0,
      price: +$('bk-price').value || 0, paid: +$('bk-paid').value || 0,
      email: $('bk-email').value.trim(), phone: $('bk-phone').value.trim(),
      note: $('bk-note').value.trim(), confirmedAt: prev.confirmedAt || ''
    };
    var clash = list.filter(function (b) {
      return b.apt === rec.apt && b.id !== rec.id && !(b.to <= rec.from || b.from >= rec.to);
    });
    if (id) list = list.map(function (b) { return b.id === id ? rec : b; });
    else list.push(rec);
    KP.save(list); resetForm(); renderAll();
    KP.toast(clash.length ? 'Uložené — pozor, termín sa prekrýva s inou rezerváciou' : 'Rezervácia uložená');
  });

  function editBooking(id) {
    var b = KP.load().filter(function (x) { return x.id === id; })[0];
    if (!b) return;
    $('bk-id').value = b.id; $('bk-apt').value = b.apt; $('bk-from').value = b.from;
    $('bk-to').value = b.to; $('bk-name').value = b.name; $('bk-status').value = b.status;
    $('bk-guests').value = b.guests || ''; $('bk-price').value = b.price || '';
    $('bk-paid').value = b.paid || ''; $('bk-email').value = b.email || '';
    $('bk-phone').value = b.phone || ''; $('bk-note').value = b.note || '';
    $('formTitle').textContent = 'Úprava rezervácie';
    $('submitBtn').textContent = 'Uložiť zmeny';
    $('cancelEdit').hidden = false;
    updateCalc();
    $('formPanel').scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function setPaid(id, value) {
    var list = KP.load().map(function (b) {
      if (b.id !== id) return b;
      b.paid = Math.max(0, Math.round(value));
      return b;
    });
    KP.save(list); renderAll();
    KP.toast('Platba zapísaná');
  }

  /* ---------- zoznam ---------- */
  function renderList() {
    var list = KP.load().slice().sort(function (a, b) { return a.from < b.from ? -1 : 1; });
    var el = $('bkList');
    if (!list.length) { el.innerHTML = '<div class="empty">Zatiaľ žiadne rezervácie.</div>'; return; }

    el.innerHTML = list.map(function (b) {
      var a = KP.apt(b.apt), st = KP.payState(b);
      var pct = KP.price(b) ? Math.min(100, Math.round(KP.paid(b) / KP.price(b) * 100)) : 0;
      var money = KP.price(b)
        ? '<div class="pay"><div class="pay-bar"><span class="' + st + '" style="width:' + pct + '%"></span></div>' +
          '<div class="pay-txt"><b>' + KP.eur(KP.paid(b)) + '</b> z ' + KP.eur(KP.price(b)) +
          (KP.due(b) ? ' · zostáva <b>' + KP.eur(KP.due(b)) + '</b>' : ' · uhradené') + '</div></div>'
        : '<div class="pay-txt" style="color:var(--muted)">cena nezadaná</div>';

      return '<div class="bk' + (b.status === 'opt' ? ' opt' : '') + '" data-row="' + b.id + '">' +
        '<span class="tag"></span>' +
        '<div class="bk-main">' +
          '<div class="who">' + (b.name || 'Rezervácia') +
            '<span class="badge ' + st + '">' + KP.PAY_LABEL[st] + '</span>' +
            (b.confirmedAt ? '<span class="badge sent">potvrdenie odoslané</span>' : '') +
          '</div>' +
          '<div class="when">' + a.name + ' · ' + a.code + ' · ' + KP.fmt(b.from) + ' – ' + KP.fmt(b.to) +
            ' · ' + KP.nights(b.from, b.to) + ' nocí' + (b.guests ? ' · ' + b.guests + ' osôb' : '') +
            (b.note ? ' · ' + b.note : '') + '</div>' +
          money +
        '</div>' +
        '<div class="acts">' +
          '<button data-edit="' + b.id + '">Upraviť</button>' +
          '<button data-pay="' + b.id + '">Platba</button>' +
          '<button data-msg="' + b.id + '">Potvrdenie</button>' +
          '<button class="del" data-del="' + b.id + '">Zmazať</button>' +
        '</div>' +
        '<div class="pay-edit" id="pe-' + b.id + '"' + (openPay === b.id ? '' : ' hidden') + '>' +
          '<button class="chip" data-quick="dep" data-id="' + b.id + '">Záloha ' + KP.KONTAKT.zalohaPct + ' % (' + KP.eur(KP.deposit(b)) + ')</button>' +
          '<button class="chip" data-quick="full" data-id="' + b.id + '">Doplatené v plnej výške</button>' +
          '<button class="chip" data-quick="zero" data-id="' + b.id + '">Vynulovať</button>' +
          '<span class="custom"><input type="number" min="0" step="1" placeholder="vlastná suma" id="pc-' + b.id + '" value="' + (KP.paid(b) || '') + '">' +
          '<button class="chip on" data-quick="custom" data-id="' + b.id + '">Uložiť</button></span>' +
        '</div>' +
      '</div>';
    }).join('');

    el.querySelectorAll('[data-edit]').forEach(function (x) { x.onclick = function () { editBooking(x.dataset.edit); }; });
    el.querySelectorAll('[data-del]').forEach(function (x) {
      x.onclick = function () {
        if (!confirm('Naozaj zmazať túto rezerváciu?')) return;
        KP.save(KP.load().filter(function (y) { return y.id !== x.dataset.del; }));
        renderAll(); KP.toast('Rezervácia zmazaná');
      };
    });
    el.querySelectorAll('[data-pay]').forEach(function (x) {
      x.onclick = function () {
        var id = x.dataset.pay;
        openPay = openPay === id ? null : id;
        var box = $('pe-' + id);
        if (box) box.hidden = openPay !== id;
        el.querySelectorAll('.pay-edit').forEach(function (p) { if (p !== box) p.hidden = true; });
      };
    });
    el.querySelectorAll('[data-quick]').forEach(function (x) {
      x.onclick = function () {
        var id = x.dataset.id;
        var b = KP.load().filter(function (y) { return y.id === id; })[0];
        if (!b) return;
        var k = x.dataset.quick;
        if (k === 'dep') setPaid(id, KP.deposit(b));
        else if (k === 'full') setPaid(id, KP.price(b));
        else if (k === 'zero') setPaid(id, 0);
        else setPaid(id, +($('pc-' + id) || {}).value || 0);
      };
    });
    el.querySelectorAll('[data-msg]').forEach(function (x) { x.onclick = function () { openMsg(x.dataset.msg); }; });
  }

  /* ---------- štatistiky ---------- */
  function renderStats() {
    var list = KP.load().filter(function (b) { return String(b.from).slice(0, 4) === String(year); });
    var nights = 0, opts = 0, price = 0, paid = 0;
    list.forEach(function (b) {
      if (b.status === 'opt') opts++; else nights += KP.nights(b.from, b.to);
      if (b.status !== 'opt') { price += KP.price(b); paid += KP.paid(b); }
    });
    var seasonNights = 214 * 2;
    $('statYear').textContent = year;
    $('stCount').textContent = list.length;
    $('stNights').textContent = nights;
    $('stOpts').textContent = opts;
    $('stFill').textContent = Math.round(nights / seasonNights * 100) + ' %';
    $('stPrice').textContent = KP.eur(price);
    $('stPaid').textContent = KP.eur(paid);
    $('stDue').textContent = KP.eur(Math.max(0, price - paid));
    $('moneyBar').style.width = (price ? Math.min(100, Math.round(paid / price * 100)) : 0) + '%';
  }

  function renderAll() {
    $('yv').textContent = year;
    renderList(); renderStats();
    KP.renderCalendars($('cals'), year, { allYear: false });
  }
  $('prevY').onclick = function () { year--; renderAll(); };
  $('nextY').onclick = function () { year++; renderAll(); };

  /* ---------- potvrdzovacia správa ---------- */
  var msgId = null;
  function openMsg(id) {
    var b = KP.load().filter(function (x) { return x.id === id; })[0];
    if (!b) return;
    msgId = id;
    var m = KP.sprava(b);
    $('msgFor').textContent = (b.name || 'Rezervácia') + ' · ' + KP.apt(b.apt).name + ' · ' +
      KP.fmt(b.from) + ' – ' + KP.fmt(b.to) +
      (b.email ? ' · ' + b.email : ' · e-mail nie je zadaný') +
      (b.phone ? ' · ' + b.phone : '');
    $('msgTitle').textContent = b.status === 'opt' ? 'Predbežná rezervácia' : 'Potvrdenie pre hosťa';
    $('msgSubject').value = m.subject;
    $('msgBody').value = m.body;
    $('msgSms').value = m.sms;
    syncLinks();
    $('msgModal').hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function syncLinks() {
    var b = KP.load().filter(function (x) { return x.id === msgId; })[0] || {};
    $('mailtoBtn').href = 'mailto:' + encodeURIComponent(b.email || '') +
      '?subject=' + encodeURIComponent($('msgSubject').value) +
      '&body=' + encodeURIComponent($('msgBody').value);
    $('smsBtn').href = 'sms:' + (b.phone || '').replace(/\s/g, '') + '?&body=' + encodeURIComponent($('msgSms').value);
    var n = $('msgSms').value.length;
    $('smsLen').textContent = '· ' + n + ' znakov (' + Math.ceil(n / 160) + ' SMS)';
  }
  ['msgSubject', 'msgBody', 'msgSms'].forEach(function (id) { $(id).addEventListener('input', syncLinks); });

  function closeMsg() { $('msgModal').hidden = true; document.body.style.overflow = ''; }
  $('msgClose').onclick = closeMsg;
  $('msgModal').addEventListener('click', function (e) { if (e.target === $('msgModal')) closeMsg(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !$('msgModal').hidden) closeMsg(); });

  document.querySelectorAll('.tabs .tab').forEach(function (t) {
    t.onclick = function () {
      document.querySelectorAll('.tabs .tab').forEach(function (x) { x.classList.remove('on'); });
      t.classList.add('on');
      $('paneEmail').hidden = t.dataset.tab !== 'email';
      $('paneSms').hidden = t.dataset.tab !== 'sms';
    };
  });
  document.querySelectorAll('[data-copy]').forEach(function (btn) {
    btn.onclick = function () {
      var v = $(btn.dataset.copy).value;
      if (navigator.clipboard) navigator.clipboard.writeText(v).then(function () { KP.toast('Skopírované'); });
      else { $(btn.dataset.copy).select(); document.execCommand('copy'); KP.toast('Skopírované'); }
    };
  });
  $('markSentBtn').onclick = function () {
    KP.save(KP.load().map(function (b) {
      if (b.id === msgId) b.confirmedAt = KP.iso(new Date());
      return b;
    }));
    closeMsg(); renderAll(); KP.toast('Označené ako odoslané');
  };

  /* ---------- export / import ---------- */
  function download(name, text) {
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([text], { type: 'application/json' }));
    a.download = name; a.click();
  }
  $('publishBtn').onclick = function () {
    download('bookings.json', JSON.stringify(KP.load(), null, 2));
    KP.toast('Ulož ako data/bookings.json a commitni do repozitára');
  };
  $('exportBtn').onclick = function () {
    download('kucapuca-rezervacie-' + KP.iso(new Date()) + '.json', JSON.stringify(KP.load(), null, 2));
    KP.toast('Exportované');
  };
  $('importInput').onchange = function (e) {
    var f = e.target.files[0]; if (!f) return;
    var r = new FileReader();
    r.onload = function () {
      try {
        var v = JSON.parse(r.result);
        if (!Array.isArray(v)) throw 0;
        KP.save(v); renderAll(); KP.toast('Importovaných ' + v.length + ' záznamov');
      } catch (err) { KP.toast('Súbor sa nepodarilo načítať'); }
      e.target.value = '';
    };
    r.readAsText(f);
  };
  $('seedBtn').onclick = function () {
    if (!confirm('Načítať znova dáta zo súboru data/bookings.json a prepísať zmeny v tomto prehliadači?')) return;
    KP.reset(); KP.boot(function () { renderAll(); KP.toast('Načítané z data/bookings.json'); });
  };
  $('wipeBtn').onclick = function () {
    if (!confirm('Vymazať všetky rezervácie?')) return;
    KP.save([]); renderAll(); KP.toast('Vymazané');
  };
})();
</script>
