<section class="page-head pad-sm">
  <div class="wrap">
    <span class="pill rv">Kontakt</span>
    <h1 class="rv">Napíšte nám termín — ozveme sa s <em class="ac">dostupnosťou</em></h1>
    <p class="lead rv" style="margin-top:24px">Poradíme, ktorý apartmán sedí vašej partii, a pripravíme cenu na mieru pobytu. Nezáväzne, obvykle do 24 hodín.</p>
  </div>
</section>

<section class="pad-sm">
  <div class="wrap">
    <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(26px,4vw,64px);align-items:start" class="contact-grid">
      <div class="rv">
        <div class="info-list">
          <a href="tel:+421904226700">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1.1 1A16 16 0 0 1 4 5.1 1 1 0 0 1 5 4z"/></svg>
            <span><b>Telefón</b>+421 904 226 700</span>
          </a>
          <a href="mailto:hello@kucapuca.sk">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <span><b>E-mail</b>hello@kucapuca.sk</span>
          </a>
          <a href="https://maps.google.com/?q=Sepunatka+11E,+23234+Vir,+Hrvatska" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="10" r="3"/><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/></svg>
            <span><b>Adresa</b>Sepunatka 11/E, 23234 Vir, Chorvátsko</span>
          </a>
          <div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            <span><b>Check-in / check-out</b>od 15:00 / do 10:00</span>
          </div>
        </div>
        <div style="margin-top:34px;display:flex;gap:10px;flex-wrap:wrap">
          <a class="btn btn-primary" href="mailto:hello@kucapuca.sk?subject=Dopyt%20na%20term%C3%ADn%20%E2%80%94%20Villa%20Kuca%20Puca">Napísať e-mail</a>
          <a class="btn btn-ghost" href="obsadenost.html">Pozrieť obsadenosť</a>
        </div>
        <div style="margin-top:40px">
          <p class="label" style="margin-bottom:10px">Majiteľ</p>
          <p class="lead">Marek Náhlik — majiteľ</p>
        </div>
      </div>

      <div class="panel rv">
        <h3>Nezáväzný dopyt</h3>
        <p class="hint">Vyplňte pár údajov — otvorí sa vám e-mail s pripravenou správou, stačí odoslať.</p>
        <form id="inqForm">
          <div class="field"><label for="f-name">Meno a priezvisko</label><input id="f-name" name="name" required placeholder="Ján Novák"></div>
          <div class="row2">
            <div class="field"><label for="f-from">Príchod</label><input id="f-from" name="from" type="date" required></div>
            <div class="field"><label for="f-to">Odchod</label><input id="f-to" name="to" type="date" required></div>
          </div>
          <div class="row2">
            <div class="field"><label for="f-apt">Apartmán</label>
              <select id="f-apt" name="apt">
                <option value="Kuca (6+1)">Kuca · 6+1</option>
                <option value="Puca (4+1)">Puca · 4+1</option>
                <option value="Celá vila (10–13)">Celá vila · 10–13</option>
                <option value="Poraďte mi">Poraďte mi</option>
              </select></div>
            <div class="field"><label for="f-ppl">Počet osôb</label><input id="f-ppl" name="ppl" type="number" min="1" max="13" value="4"></div>
          </div>
          <div class="field"><label for="f-msg">Poznámka</label><textarea id="f-msg" name="msg" placeholder="Deti, domáce zvieratá, špeciálne želania…"></textarea></div>
          <button class="btn btn-primary" type="submit">Odoslať dopyt</button>
          <p class="hint" style="margin:14px 0 0;text-align:center">Alebo rovno zavolajte na +421 904 226 700</p>
        </form>
      </div>
    </div>
  </div>
</section>

<section class="pad-sm">
  <div class="wrap">
    <div class="marquee-stage rv">
      <img src="img/pobrezie-3.jpg" alt="Vir z výšky" loading="lazy">
      <div class="marquee">
        <div class="track">
          <span>VIDÍME SA</span><i></i><span class="ac">na Vire</span><i></i><span>VIDÍME SA</span><i></i><span class="ac">na Vire</span><i></i>
          <span>VIDÍME SA</span><i></i><span class="ac">na Vire</span><i></i><span>VIDÍME SA</span><i></i><span class="ac">na Vire</span><i></i>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
document.getElementById('inqForm').addEventListener('submit', function (e) {
  e.preventDefault();
  var f = e.target;
  var body =
    'Meno: ' + f.name.value + '\n' +
    'Termín: ' + f.from.value + ' – ' + f.to.value + '\n' +
    'Apartmán: ' + f.apt.value + '\n' +
    'Počet osôb: ' + f.ppl.value + '\n\n' +
    (f.msg.value || '');
  window.location.href = 'mailto:hello@kucapuca.sk?subject=' +
    encodeURIComponent('Dopyt na termín — ' + f.apt.value) +
    '&body=' + encodeURIComponent(body);
});
</script>
